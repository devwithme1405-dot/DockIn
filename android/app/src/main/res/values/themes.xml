<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DockIn" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/status_bar</item>
    </style>

    <!-- Shown the instant the icon is tapped: flat brand colour and a small mark. -->
    <style name="Theme.DockIn.Starting" parent="Theme.DockIn">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
    </style>
</resources>
