<?xml version="1.0" encoding="utf-8"?>
<!-- The leather plate every DockIn tab starts with: brown hide, a soft
     highlight on top, and the cream stitching just inside its edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#9C5328" android:centerColor="#844020" android:endColor="#6C3416" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#8CFFE2BE" android:dashWidth="5dp" android:dashGap="3dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
