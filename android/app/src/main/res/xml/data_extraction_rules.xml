<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of DockIn leaves the phone in a backup or a phone-to-phone transfer:
     the login, the Camu and LMS sessions and the chats stay on this phone only.
     Everything that matters comes back from the cloud after signing in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
