<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DockIn" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/status_bar</item>
    </style>

    <!-- Android 12+ draws the splash itself: brand colour and the mark. -->
    <style name="Theme.DockIn.Starting" parent="Theme.DockIn">
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
    </style>
</resources>
