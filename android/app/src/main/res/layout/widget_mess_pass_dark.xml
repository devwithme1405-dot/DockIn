<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_dark" android:padding="7dp">
    <!-- The leather plate, like the top of every DockIn tab. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_leather" android:paddingLeft="11dp" android:paddingRight="11dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/w_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="🎫" android:textSize="17sp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mess pass"
                android:textColor="#FFFFF6EA" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                android:shadowColor="#8C321405" android:shadowDy="1" android:shadowRadius="1" />
            <TextView android:id="@+id/w_hsub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF0CFA6"
                android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#FFFFF1DD" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp"
        android:orientation="vertical" android:background="@drawable/widget_qr_bg" android:padding="8dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/w_qr" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center"
                android:padding="6dp" android:scaleType="fitCenter" android:adjustViewBounds="true" android:contentDescription="Mess pass QR" />
            <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
                android:textColor="#8A6A52" android:textSize="12.5sp" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/w_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center"
            android:text="Tap to open full screen" android:textColor="#B85D1C" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
