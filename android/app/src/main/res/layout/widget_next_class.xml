<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="🕘" android:textSize="15sp" />
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp"
            android:text="Next class" android:textColor="@color/widget_ink" android:textSize="14.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#8A6A52" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp"
        android:textColor="@color/widget_ink" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:id="@+id/w_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="13sp" android:maxLines="1" />
        <TextView android:id="@+id/w_room" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/widget_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ProgressBar android:id="@+id/w_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="9dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_accent" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_thenbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="9dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_then" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/widget_muted" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
