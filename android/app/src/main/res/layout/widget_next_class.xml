<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Next class" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_chip"
            android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="@color/widget_ink" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/widget_ink" android:textSize="19sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textColor="@color/widget_ink" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_room" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_muted" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_then" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
