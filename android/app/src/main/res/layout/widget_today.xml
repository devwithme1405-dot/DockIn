<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="📅" android:textSize="15sp" />
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp"
            android:text="Today's classes" android:textColor="@color/widget_ink" android:textSize="14.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#8A6A52" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="4dp" />
    <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t1" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d1" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t2" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d2" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t3" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d3" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t4" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d4" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t5" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d5" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_t6" android:layout_width="62dp" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/w_d6" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_a6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11.5sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/widget_muted" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
