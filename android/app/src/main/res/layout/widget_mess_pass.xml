<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="🎫" android:textSize="15sp" />
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp"
            android:text="Mess pass" android:textColor="@color/widget_ink" android:textSize="14.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#8A6A52" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="9dp">
        <ImageView android:id="@+id/w_qr" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center"
            android:background="@drawable/widget_qr_bg" android:padding="8dp" android:scaleType="fitCenter" android:adjustViewBounds="true" android:contentDescription="Mess pass QR" />
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
            android:textColor="@color/widget_muted" android:textSize="12.5sp" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/w_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
        android:text="Show it at the counter" android:textColor="@color/widget_muted" android:textSize="11.5sp" />
</LinearLayout>
