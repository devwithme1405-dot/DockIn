<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_dark" android:padding="7dp">
    <!-- The leather plate, like the top of every DockIn tab. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_leather" android:paddingLeft="11dp" android:paddingRight="11dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/w_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="📊" android:textSize="17sp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Attendance"
                android:textColor="#FFFFF6EA" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                android:shadowColor="#8C321405" android:shadowDy="1" android:shadowRadius="1" />
            <TextView android:id="@+id/w_hsub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF0CFA6"
                android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#FFFFF1DD" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp"
        android:orientation="vertical" android:background="@drawable/widget_card_dark" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ring" android:layout_width="76dp" android:layout_height="76dp" android:scaleType="fitCenter" android:contentDescription="Attendance" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink_dark" android:textSize="15.5sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/widget_muted_dark" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_subjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="2dp" android:visibility="gone">
        <LinearLayout android:id="@+id/w_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink_dark" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted_dark" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb1_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb1_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb1_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger_dark" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink_dark" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted_dark" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb2_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb2_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb2_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger_dark" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_s3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink_dark" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted_dark" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb3_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb3_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn_dark" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb3_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger_dark" android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
