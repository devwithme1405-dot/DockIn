<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Tasks" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_chip"
            android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="@color/widget_ink" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_a1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
            android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_a2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
            android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_a3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
            android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_a4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
            android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/w_a5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" android:textSize="13.5sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_b5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
            android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/widget_muted" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
