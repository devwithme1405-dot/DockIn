<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_tile"
            android:gravity="center" android:text="📊" android:textSize="15sp" />
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp"
            android:text="Attendance" android:textColor="@color/widget_ink" android:textSize="14.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/chip_neutral" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#8A6A52" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <ImageView android:id="@+id/w_ring" android:layout_width="78dp" android:layout_height="78dp" android:scaleType="fitCenter" android:contentDescription="Attendance" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="15.5sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_subjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <LinearLayout android:id="@+id/w_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb1_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb1_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb1_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb2_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb2_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb2_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_s3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_sc3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_sp3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <ProgressBar android:id="@+id/w_sb3_safe" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_safe" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb3_warn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_warn" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_sb3_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="3dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_danger" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
