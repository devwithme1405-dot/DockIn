<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: the "where did it go?" prompt after each payment. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the hourly Camu/LMS check scheduled across a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets DockIn ask to be left out of battery saving, so payments are caught when closed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The quiet "Watching for payments" service that keeps reading alive when the app is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Camu's own sign-in page, so DockIn can read attendance with his session. -->
        <activity
            android:name=".CamuLoginActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <!-- The small "what was it for?" sheet after a payment. Its own task, so it
             never drags the whole app to the front, and never shows in Recents. -->
        <activity
            android:name=".PayAskActivity"
            android:theme="@style/AppTheme.PayAsk"
            android:taskAffinity="com.dockin.student.payask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Keeps the process (and so payment detection) alive when closed. -->
        <service
            android:name=".PayGuardService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches payment apps on the phone so each payment can be filed the moment it happens." />
        </service>

        <!-- Payment reading comes back after a restart or an app update, without opening DockIn. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Fires scheduled reminders (class starting, task due, attendance low). -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- "For me" on the payment notification: saves without opening anything. -->
        <receiver
            android:name=".PayActionReceiver"
            android:exported="false" />

        <!-- Every 15 minutes: is payment detection still on? Says so if the phone switched it off. -->
        <service
            android:name=".PayHealthJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- The hourly check of Camu and the LMS. -->
        <service
            android:name=".CollegeJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!--
            Payment detection. Reads only the payment apps listed in
            PayWatchService, keeps what it finds on the phone, and runs only
            once it is switched on in Android's notification-access screen.
        -->
        <service
            android:name=".PayWatchService"
            android:label="@string/pay_watch_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Payment success screens. Android sends this only the payment apps
            named in res/xml/pay_screen.xml, and only once the person switches
            it on in Accessibility. Being bound by Android, it also brings the
            payment watch back when DockIn is swiped out of Recents.
        -->
        <service
            android:name=".PayScreenService"
            android:label="@string/pay_screen_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pay_screen" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
